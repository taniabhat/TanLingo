# Backend environment variables (copy to backend/.env)

# JWT
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SMTP — required for registration welcome emails
# Leave SMTP_HOST empty to skip sending (registration still succeeds)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=TanLingo
SMTP_USE_TLS=true

# Frontend URL (used in welcome email links)
APP_URL=http://localhost:3000

# Allow demo token for testing (set false in production)
ALLOW_DEMO_TOKEN=true
